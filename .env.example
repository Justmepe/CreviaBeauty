# CreviaBeauty - Environment Configuration Example
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000

# Session Configuration (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your-secure-64-character-random-string-here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/creviabeauty
# Or use individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creviabeauty
DB_USER=postgres
DB_PASSWORD=your_password

# File Upload Configuration (in bytes, 5MB = 5242880)
UPLOAD_MAX_SIZE=5242880

# Cookie Configuration (set to true in production with HTTPS)
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Logging
LOG_LEVEL=info

# Discord webhook for new-order notifications (optional — leave blank to disable)
DISCORD_WEBHOOK_URL=

# Discord webhook for Content Calendar due-reminders (optional — separate channel)
CONTENT_DISCORD_WEBHOOK_URL=
# Timezone the scheduled post times are entered in (reminders fire in this zone).
CONTENT_TZ=Africa/Nairobi
# Default post time (hour 0-23) for items scheduled without an explicit time. Default 9.
CONTENT_REMIND_HOUR=9
# Fire the reminder this many minutes BEFORE the scheduled time (0 = exactly on time).
CONTENT_REMIND_LEAD_MIN=0

# Seed demo/sample catalog data on startup (sample decants, local-brand SKUs,
# demo reviews, hero slides, articles). Leave OFF in production so deploys never
# (re)inject test products. Set to true only for a fresh local/dev database.
SEED_DEMO_DATA=false
